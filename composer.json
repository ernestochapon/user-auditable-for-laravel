{
    "name": "ernestochapon/user-auditable-for-laravel",
    "description": "Laravel package for user auditing in migrations and models",
    "version": "1.5.2",
    "type": "library",
    "keywords": [
        "laravel",
        "audit",
        "user",
        "migration",
        "model",
        "tracking",
        "auditable",
        "macros"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernesto Chapon",
            "email": "ernestochapon@gmail.com",
            "homepage": "https://github.com/ernestochapon"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": ">=9.0 <14.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "nunomaduro/collision": "^6.0|^7.0|^8.0",
        "doctrine/dbal": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestoChapon\\UserAuditable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestoChapon\\UserAuditable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ErnestoChapon\\UserAuditable\\Providers\\UserAuditableServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "release:patch": "php tagger.php",
        "release:minor": "echo 'Update version in composer.json then run release:patch'",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "test-verbose": "vendor/bin/phpunit --verbose"
    }
}
